{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student in the school.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the student" },
        "class": { "type": "string", "description": "Class/Section of the student" },
        "phone": { "type": "string", "description": "Phone number of the student (used as ID/Login)" }
      },
      "required": ["name", "class", "phone"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Represents an attendance record for a student on a specific date.",
      "type": "object",
      "properties": {
        "studentPhone": { "type": "string", "description": "Reference to the student's phone number" },
        "date": { "type": "string", "format": "date", "description": "Date of attendance (YYYY-MM-DD)" },
        "status": { "type": "string", "enum": ["present", "absent", "late"], "description": "Attendance status" },
        "time": { "type": "string", "description": "Time of recording" }
      },
      "required": ["studentPhone", "date", "status"]
    },
    "Excuse": {
      "title": "Excuse",
      "description": "Represents an absence excuse submitted by a student guardian with medical attachment.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Student identifier" },
        "studentName": { "type": "string", "description": "Full name of the student" },
        "studentNationalId": { "type": "string", "description": "National ID of the student" },
        "studentClass": { "type": "string", "description": "Class of the student" },
        "date": { "type": "string", "description": "Date of absence" },
        "type": { "type": "string", "description": "Excuse category" },
        "desc": { "type": "string", "description": "Description of the excuse" },
        "fileUrl": { "type": "string", "description": "Optimized base64 data URL of the attachment" },
        "fileName": { "type": "string", "description": "Attachment file name" },
        "isCameraCaptured": { "type": "boolean", "description": "Whether captured via camera" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"], "description": "Review status" },
        "adminReply": { "type": "string", "description": "Administrative reply" },
        "createdAt": { "type": "string", "description": "Submission ISO timestamp" }
      },
      "required": ["studentId", "studentName", "date", "type", "status"]
    }
  },
  "firestore": {
    "students": {
      "schema": "Student",
      "description": "Collection of students"
    },
    "attendance": {
      "schema": "Attendance",
      "description": "Collection of attendance records"
    },
    "excuses": {
      "schema": "Excuse",
      "description": "Collection of student absence excuses"
    }
  }
}
